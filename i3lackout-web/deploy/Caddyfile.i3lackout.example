# Vorlage für den statischen Caddy-Site-Block von i3lackout.com
# Hinweis: Erst nach separater Freigabe sowie abgeschlossener Inhalt-/Rechtsprüfung auf dem VPS aktivieren.
# MusicChain (musicchaini3.com) läuft weiterhin unabhängig über Waitress/Flask.

www.i3lackout.com {
	redir https://i3lackout.com{uri} permanent
}

i3lackout.com {
	root * /var/www/i3lackout-web/dist
	encode zstd gzip

	# Sicherheitsheader
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "frame-ancestors 'self' https://musicchaini3.com https://www.musicchaini3.com"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Gehashte Vite-Assets langfristig cachen
	@hashed_assets path /assets/*
	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

	# Einstiegs-HTML nicht langfristig cachen, damit Releases sofort ankommen
	@html_entry path / /index.html
	header @html_entry Cache-Control "no-cache, must-revalidate"

	# SPA-Fallback auf index.html für clientseitige Routen (/developer, /projects, /certifications, /tech-stack, ...)
	try_files {path} /index.html
	file_server
}
